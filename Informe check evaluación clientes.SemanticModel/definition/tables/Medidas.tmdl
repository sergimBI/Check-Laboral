table Medidas
	lineageTag: ce0fb7ef-b5a8-4754-8d10-56c661de0fca

	measure 'Índice de riesgo' = ```
			
			    DIVIDE (
			        [Puntos obtenidos],
			        [Puntos máximos aplicables],
			        "n/a"
			    )
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 506ef6be-9091-45ba-a876-c06fc21663ca

	measure 'Puntos obtenidos' = ```
			
			    COALESCE (
			        SUM ( 'Respuestas vertical'[Respuesta] = "No" ),
			        0
			    )
			```
		lineageTag: 9ab17131-08fd-40f4-9132-cc59b7b512ef

	measure 'Puntos máximos aplicables' =
			
			CALCULATE (
			    COUNTROWS ( 'Respuestas vertical' ),
			    'Respuestas vertical'[Respuesta] = "Sí" || 'Respuestas vertical'[Respuesta] = "No",
			    NOT ISBLANK ( 'Respuestas vertical'[Respuesta] )
			)
		formatString: 0
		lineageTag: ca72f5ec-9747-4845-911c-791d2148748d

	measure 'Resultado mostrado' =
			
			VAR Aplicabilidad =
			    SELECTEDVALUE ( 'Detall_Preguntes'[Aplicabilidad] )
			
			RETURN
			    IF (
			        Aplicabilidad = "No aplica",
			        "No aplica",
			        FORMAT ( [Puntos obtenidos], "0" )
			    )
		lineageTag: 2a0fa1f1-dfe8-47b6-bb28-f6cd65670b8f

	column Columna1
		dataType: string
		lineageTag: f6168f03-fa16-4515-a852-8f933ca8c99e
		summarizeBy: none
		sourceColumn: Columna1

		annotation SummarizationSetBy = Automatic

	partition Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}})
				in
				    #"Tipo cambiado"

	annotation PBI_ResultType = Table

